{
  "permissions": {
    "allow": ["read", "write", "edit", "bash", "glob", "grep", "web", "notify", "search_files"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "file",
        "command": "bash scripts/session-start.sh"
      }
    ],
    "PostToolUse": [],
    "MessageStop": [
      {
        "matcher": "any",
        "command": "bash scripts/session-end.sh"
      }
    ]
  },
  "plugins": {
    "marketplaces": ["thedotmack/claude-mem"]
  }
}
